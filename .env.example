# BOT Chain Testnet Deployer Private Key (get testnet BOT from https://faucet.botchain.ai)
DEPLOYER_PRIVATE_KEY=

# Reown AppKit Project ID (from https://dashboard.reown.com/)
VITE_REOWN_PROJECT_ID=

# Optional separate test wallet keys for live multi-wallet verification (npm run verify:testnet)
TEST_WALLET_2_PRIVATE_KEY=
TEST_WALLET_3_PRIVATE_KEY=

# BOT Chain Testnet RPC
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life

# Deployed WaitlistHub contract address (populated automatically by `npm run deploy:testnet`)
WAITLIST_HUB_ADDRESS=
VITE_WAITLIST_HUB_ADDRESS=
