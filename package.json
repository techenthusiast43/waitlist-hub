  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}

