{
  "name": "waitlisthub-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "WaitlistHub smart contract, tests, and deployment scripts for BOT Chain Testnet",
  "scripts": {
    "compile": "hardhat compile",
